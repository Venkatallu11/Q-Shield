{
  "experiment": "ablation",
  "question": "Is the benefit attributable to attack-path awareness, or to exhaustive search over migration plans?",
  "design": {
    "arms": {
      "flat_priority": "graph-blind greedy heuristic (no search, no paths)",
      "node_only": "exhaustive search minimising node risk only (search, no paths)",
      "path_aware": "exhaustive search minimising the full objective (search + paths)"
    },
    "controls_for": "path_aware - node_only isolates path-awareness at equal search power; node_only - flat_priority isolates search power at equal path-blindness",
    "held_out_metrics": [
      "path_max",
      "expected_objective"
    ],
    "in_objective_metrics": [
      "objective"
    ],
    "instances": 400,
    "monte_carlo_trials_per_instance": 200,
    "common_random_numbers": true,
    "weights": [
      0.55,
      0.3,
      0.15
    ],
    "perturbation": {
      "unit_spread": 0.08,
      "lifetime_spread": 0.15,
      "reliability_low": 0.9,
      "reliability_high": 1.05,
      "quantum_factor_spread": 0.25,
      "weight_spread": 0.2
    },
    "generator": {
      "nodes": 7,
      "cross_links": 7,
      "budget_low": 1.5,
      "budget_high": 4.0,
      "reliability_low": 0.2,
      "reliability_high": 1.0,
      "backbone_reliability_low": 0.7
    },
    "seed": 20260907
  },
